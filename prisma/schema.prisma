generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String         @id @default(cuid())
  username             String         @unique
  displayName          String?
  isPrimary            Boolean        @default(false)
  publicMode           Boolean        @default(true)
  hasExactSolvedData   Boolean        @default(false)
  lastSyncAt           DateTime?
  lastFullSyncAt       DateTime?
  totalSolved          Int            @default(0)
  totalEasy            Int            @default(0)
  totalMedium          Int            @default(0)
  totalHard            Int            @default(0)
  estimatedRating      Int?
  contestRating        Float?
  contestGlobalRanking Int?
  readinessScore       Int?
  streakCurrent        Int            @default(0)
  streakLongest        Int            @default(0)
  lastSyncStatus       String?
  syncMessage          String?
  submissionCalendar   String?
  topicCounts          String?
  recentAccepted       String?
  weeklySummary        String?
  leetcodeSession      String?
  leetcodeCsrfToken    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  bookmarks            Bookmark[]
  contestHistory       ContestHistory[]
  solvedProblems       UserProblem[]
  submissions          Submission[]
}

model Problem {
  slug        String       @id
  frontendId  String?
  title       String
  normalized  String       @unique
  difficulty  String
  rating      Int?
  topicNames  String
  url         String
  isPaidOnly  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookmarks   Bookmark[]
  solvedBy    UserProblem[]
  submissions Submission[]
}

model UserProblem {
  id            String          @id @default(cuid())
  userId        String
  problemSlug   String
  source        String
  confidence    String          @default("EXACT")
  firstSolvedAt DateTime?
  lastSolvedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  problem       Problem         @relation(fields: [problemSlug], references: [slug], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug])
}

model Submission {
  id          String     @id @default(cuid())
  userId      String
  problemSlug String
  leetCodeId  String?
  submittedAt DateTime
  source      String
  isAccepted  Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  problem     Problem    @relation(fields: [problemSlug], references: [slug], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug, submittedAt])
}

model Bookmark {
  id          String        @id @default(cuid())
  userId      String
  problemSlug String
  label       String
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  problem     Problem       @relation(fields: [problemSlug], references: [slug], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug])
}

model ContestHistory {
  id                String   @id @default(cuid())
  userId            String
  contestTitle      String
  contestStartTime  DateTime
  rating            Float
  ranking           Int?
  problemsSolved    Int?
  totalProblems     Int?
  finishTimeSeconds Int?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contestTitle, contestStartTime])
}
